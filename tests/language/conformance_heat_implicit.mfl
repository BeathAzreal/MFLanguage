import heat
heat.bar(1 m, 1 W/(m*K), 1 kg/m^3, 1 J/(kg*K))
heat.nodes(3)
heat.initial_temperature(400 K)
heat.left_convection(coefficient: 1 W/(m^2*K), ambient: 300 K)
heat.right_convection(1 W/(m^2*K), 300 K)
heat.method("backward_euler")
heat.time_step(1 s)
heat.end_time(1 s)
heat.run()
print(heat.sample_count())
print(heat.temperature(0 m, 1 s) > 330 K)
print(heat.temperature(0 m, 1 s) < 333 K)
print(heat.temperature(0.5 m, 1 s) > 339 K)
print(heat.temperature(0.5 m, 1 s) < 340 K)
